{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-attribution.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__(create_pull_request|update_pull_request|issue_write|merge_pull_request|pull_request_review_write|push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-claude-app-writes.sh\""
          }
        ]
      }
    ]
  }
}
